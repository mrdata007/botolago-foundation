# Public HTTPS origin of this dedicated service, not the existing consumer MCP.
ADMIN_MCP_ORIGIN=https://admin-mcp.example.com
ADMIN_MCP_HOST=127.0.0.1
ADMIN_MCP_PORT=3107
ADMIN_MCP_DATA_DIR=./data
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key outside git. Losing/changing it invalidates saved connections.
ADMIN_MCP_ENCRYPTION_KEY=
# Production V2: use the URL and PUBLISHABLE key from that project's settings.
# A service-role/secret key is not supported.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
