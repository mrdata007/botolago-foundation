# Local development defaults. Copy to .env.local; never commit real credentials.
VITE_AUTH_MODE=mock
VITE_FOOTBALL_DATA_MODE=mock
VITE_NEWS_DATA_MODE=mock
VITE_NOTIFICATIONS_DATA_MODE=mock
VITE_FANTASY_DATA_MODE=mock
VITE_APP_URL=http://127.0.0.1:3000
VITE_SUPABASE_PROJECT_ID=local
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=<local-publishable-key-from-supabase-status>

# Server-only values. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=<local-publishable-key-from-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-status>
# Preferred server-only key for trusted Admin commands. Never expose in Vite.
SUPABASE_SECRET_KEY=<dedicated-server-only-secret-key>

# Trusted Admin operations. Exact environment/ref pairing is mandatory.
# OWNER_ADMIN_EMAIL and OWNER_ADMIN_ACCESS_TOKEN are deliberately absent:
# inject them only into the private process running readiness/bootstrap, then
# clear them. Never store them in an env file, CI artifact, or shell history.
BOTOLAGO_ADMIN_ENVIRONMENT=local
BOTOLAGO_ADMIN_EXPECTED_PROJECT_REF=local
# Production commands additionally require their exact purpose-specific
# BOTOLAGO_ADMIN_PRODUCTION_CONFIRMATION value from the reviewed runbook.

# Admin session-revocation worker. These are server-only bounded runtime
# controls; Phase 7D does not enable a production schedule.
BOTOLAGO_ADMIN_WORKER_ID=local-admin-worker
BOTOLAGO_ADMIN_REVOCATION_BATCH_SIZE=25
BOTOLAGO_ADMIN_REVOCATION_MAX_BATCHES=4
BOTOLAGO_ADMIN_REVOCATION_LEASE_SECONDS=120
BOTOLAGO_ADMIN_SYNTHETIC_TEST=false
# A one-record dead-letter replay additionally requires runtime-only
# BOTOLAGO_ADMIN_REPLAY_CONFIRMATION and BOTOLAGO_ADMIN_REPLAY_REASON values.

# Football provider and ingestion settings are server-only. The fixture adapter
# is deterministic and never represents a live production integration.
FOOTBALL_PROVIDER=fixture
FOOTBALL_PROVIDER_BASE_URL=https://provider.example.invalid
FOOTBALL_PROVIDER_API_KEY=<server-only-provider-key>
FOOTBALL_INGESTION_CONCURRENCY=2
FOOTBALL_PROVIDER_TIMEOUT_MS=10000
FOOTBALL_PROVIDER_MAX_RETRIES=3
FOOTBALL_PROVIDER_RETRY_BASE_MS=250
FOOTBALL_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
FOOTBALL_PROVIDER_CIRCUIT_RESET_MS=30000

# News provider and ingestion settings are server-only. Phase 4 ships the
# deterministic fixture adapter; selecting a production source remains a
# reviewed operational decision and never exposes credentials to Vite.
NEWS_PROVIDER=fixture
NEWS_PROVIDER_BASE_URL=https://publisher.example.invalid
NEWS_PROVIDER_API_KEY=<server-only-provider-key>
NEWS_INGESTION_CONCURRENCY=2
NEWS_PROVIDER_TIMEOUT_MS=10000
NEWS_PROVIDER_MAX_RETRIES=3
NEWS_PROVIDER_RETRY_BASE_MS=250

# Notification delivery is server-only and disabled outside deterministic
# fixture tests until providers and credentials receive separate approval.
NOTIFICATION_PUSH_PROVIDER=fixture
NOTIFICATION_PUSH_CREDENTIAL=<server-only-push-credential>
NOTIFICATION_EMAIL_PROVIDER=fixture
NOTIFICATION_EMAIL_CREDENTIAL=<server-only-email-credential>
NOTIFICATION_PROVIDER_WEBHOOK_SECRET=<server-only-webhook-secret>
NOTIFICATION_DEEP_LINK_BASE=https://app.example.invalid
NOTIFICATION_WORKER_CONCURRENCY=2
NOTIFICATION_DELIVERY_BATCH_SIZE=100
NOTIFICATION_SCHEDULE_BATCH_SIZE=100
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
NOTIFICATION_PROVIDER_MAX_RETRIES=5
NOTIFICATION_PROVIDER_RETRY_BASE_MS=250
NOTIFICATION_RETENTION_DAYS=180

# Fantasy workers are server-only and remain unscheduled until production
# activation receives a separate review. Rules/scoring versions identify the
# immutable database configuration, not executable client logic.
FANTASY_WORKER_BATCH_SIZE=250
FANTASY_FINALIZATION_BATCH_SIZE=250
FANTASY_SCORING_VERSION=1
FANTASY_RULESET_VERSION=1
FANTASY_JOB_MAX_RETRIES=5
FANTASY_JOB_RETRY_BASE_MS=500
FANTASY_FIXTURE_MODE=deterministic

# Phase 6 staging-capacity harnesses. Create the Secret API key and independent
# user sessions only for an approved Staging V2 window, store the session cache
# outside the repository with mode 0600, and revoke/delete both after the run.
BOTOLAGO_STAGING_PROJECT_REF=<staging-project-ref>
BOTOLAGO_STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
BOTOLAGO_STAGING_PUBLISHABLE_KEY=<staging-publishable-key>
BOTOLAGO_STAGING_SECRET_KEY=<temporary-staging-secret-key>
BOTOLAGO_LOAD_ENVIRONMENT=staging-v2
BOTOLAGO_LOAD_SESSION_CACHE=/tmp/botolago-fantasy-sessions.json
BOTOLAGO_LOAD_PROFILE=merge_gate
BOTOLAGO_LOAD_USERS=2500
BOTOLAGO_LOAD_SUSTAINED_RPS=250
BOTOLAGO_LOAD_BURST_RPS=600
BOTOLAGO_LOAD_BURST_SECONDS=10
BOTOLAGO_LOAD_DURATION_SECONDS=60
BOTOLAGO_METRICS_INTERVAL_SECONDS=60
BOTOLAGO_METRICS_DURATION_SECONDS=900
BOTOLAGO_METRICS_OUTPUT=/tmp/botolago-fantasy-metrics.ndjson
