  "headings": [
    {
      "level": 1,
      "text": "Vous connaissez la Botola. À vous de jouer.",
      "fontSize": "64.4px",
      "fontWeight": "800",
      "color": "#FFFFFF"
    },
    {
      "level": 2,
      "text": "La Botola Pro, journée après journée",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    },
    {
      "level": 2,
      "text": "Trois gestes à chaque journée",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    },
    {
      "level": 3,
      "text": "Composez votre effectif",
      "fontSize": "17px",
      "fontWeight": "700",
      "color": "#060D1A"
    },
    {
      "level": 3,
      "text": "Choisissez votre capitaine",
      "fontSize": "17px",
      "fontWeight": "700",
      "color": "#060D1A"
    },
    {
      "level": 3,
      "text": "Marquez des points, grimpez au classement",
      "fontSize": "17px",
      "fontWeight": "700",
      "color": "#060D1A"
    },
    {
      "level": 2,
      "text": "Les joueurs à suivre",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    },
    {
      "level": 2,
      "text": "Pourquoi vous allez revenir",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    },
    {
      "level": 3,
      "text": "Pas encore prêt ?",
      "fontSize": "17px",
      "fontWeight": "700",
      "color": "#060D1A"
    },
    {
      "level": 3,
      "text": "Des lots pour les meilleurs managers",
      "fontSize": "22px",
      "fontWeight": "800",
      "color": "#001C49"
    },
    {
      "level": 2,
      "text": "Questions fréquentes",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    },
    {
      "level": 2,
      "text": "Votre équipe vous attend.",
      "fontSize": "46px",
      "fontWeight": "800",
      "color": "#FFFFFF"
    },
    {
      "level": 2,
      "text": "Choisissez votre langue",
      "fontSize": "34px",
      "fontWeight": "800",
      "color": "#060D1A"
    }
  ],
