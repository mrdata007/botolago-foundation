# Response headers for static files, read by Cloudflare's static-assets layer
# (the nitro build appends its own rule for the hashed /assets/* files after
# this block: `public, max-age=31536000, immutable`).
#
# The self-hosted faces keep their names across releases (no content hash in
# the file name), so they are cached for 30 days and not "immutable": a font
# that is ever replaced reaches visitors within the month. Without a rule the
# static layer answered `max-age=0, must-revalidate`, a conditional request
# for every font on every visit.
/fonts/*
  Cache-Control: public, max-age=2592000
